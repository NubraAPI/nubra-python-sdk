# Copy this file to `.env` (never commit `.env`) and fill in the two credentials.
#
# The Nubra environment (UAT/PROD) and whether orders are actually sent are NOT set
# here. They are command-line flags on main.py: UAT is the default, and orders are
# only sent with --place-orders. Every other setting below has a default in
# gamma_hedging/config.py; uncomment and edit only what you want to change.

# ---------------------------------------------------------------------------
# Credentials, read by the SDK via InitNubraSdk(..., env_creds=True).
# The SDK may still ask for an OTP on first login.
# ---------------------------------------------------------------------------
PHONE_NO=
MPIN=

# ---------------------------------------------------------------------------
# Strategies. Each one is hedged independently (own setup structure, own futures
# hedge, own thresholds, own order tag). Comma-separated names; default is one
# strategy named "strat1".
#
# Any setting in the sections below can be overridden per strategy with a
# <NAME>_<KEY> variable (for example STRAT2_STRATEGY_TYPE). If that is not set it
# falls back to the plain <KEY> variable, then to the default.
# ---------------------------------------------------------------------------
STRATEGIES=strat1

# -- Instrument selection (shared by every strategy) --
# UNDERLYING=SENSEX
# EXCHANGE=BSE
# EXPIRY_OVERRIDE=              # YYYYMMDD; empty = nearest expiry

# -- Setup structure: the short options position opened at startup --
# STRATEGY_TYPE=STRADDLE        # STRADDLE or STRANGLE
# SETUP_LOTS=1
# STRANGLE_TARGET_DELTA=0.20    # strangle legs are the strikes closest to +/- this delta
# STRANGLE_OFFSET_STRIKES=2     # fallback only, used if the chain has no delta data
# SETUP_PRICE_TYPE=MARKET       # MARKET or LIMIT

# -- Hedging --
# DELTA_TOLERANCE_LOTS=0.5      # hedge when |net delta| exceeds this many futures lots
# HIGH_GAMMA_THRESHOLD=0.20     # |net gamma| at or above this -> faster polling
# POLL_INTERVAL_NORMAL_SEC=30
# POLL_INTERVAL_HIGH_GAMMA_SEC=7
# HEDGE_PRICE_TYPE=MARKET       # MARKET or LIMIT
# MAX_FUTURES_POSITION_LOTS=20  # absolute cap on the futures hedge position

# -- Order tag. One strategy uses this tag as is; with several strategies each gets
# "<this>-<name>" unless <NAME>_STRAT_TAG is set. Hyphens only. --
# STRAT_TAG=gamma-hedge

# ---------------------------------------------------------------------------
# Example: a second strategy next to strat1, a strangle instead of a straddle,
# tagged separately and hedged independently.
# ---------------------------------------------------------------------------
# STRATEGIES=strat1,strat2
# STRAT2_STRATEGY_TYPE=STRANGLE
# STRAT2_STRANGLE_TARGET_DELTA=0.20

# ---------------------------------------------------------------------------
# Guardrails, shared across ALL strategies.
# ---------------------------------------------------------------------------
# MAX_HEDGE_TRADES_PER_MIN=4
# CIRCUIT_BREAKER_PCT=1.5       # halt if spot moves this % ...
# CIRCUIT_BREAKER_WINDOW_SEC=300  # ... within this window
# MAX_CONSECUTIVE_API_ERRORS=3

# -- Session --
# MARKET_CLOSE_TIME=15:30
# TIMEZONE=Asia/Kolkata

# -- Black-Scholes fallback, used only if the API omits a leg's Greeks --
# RISK_FREE_RATE=0.065

# -- Logging --
# LOG_DIR=logs

# -- LIMIT order aggressiveness. 0 = price at the reference (best bid/ask or LTP).
# >0 = cross the book by this percent (capped at 0.5% for the futures leg). --
# AGGRESSIVE_FILL_PCT=0

# -- Browser dashboard port (served on 127.0.0.1 only) --
# WEB_DASHBOARD_PORT=8765
