# Copy this file to .env and fill in your own values. Never commit the real .env.
# The SDK reads .env from the directory you run main.py in (InitNubraSdk(..., env_creds=True)).
# The SDK may ask for an OTP when it logs in.
#
# Everything else (UAT vs PROD, hedge settings, whether orders are sent) is a
# command-line flag on main.py; see README.md.
PHONE_NO=your_phone_number
MPIN=your_mpin
